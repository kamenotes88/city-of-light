{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "City of Light local work report",
  "description": "A data-only claim submitted by a working assistant. Import does not accept achievements, verify evidence, execute commands or complete a goal. Local owner review is separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "reportId", "artifactId", "worldId", "projectId", "goalVersion", "planVersion", "date", "title", "scope", "stage", "evidence", "nextStep", "blocker", "completesGoal"],
  "properties": {
    "format": {"const": "city-of-light-work-report"},
    "version": {"const": 1},
    "reportId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$"},
    "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,80}$"},
    "worldId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,140}$"},
    "projectId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,140}$"},
    "goalVersion": {"type": "integer", "minimum": 1},
    "planVersion": {"type": "integer", "minimum": 1},
    "planStageId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "scope": {"type": "string", "minLength": 1, "maxLength": 2000},
    "stage": {"enum": ["made", "applied", "effect"]},
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "href"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 200},
          "href": {"type": "string", "format": "evidence-url", "minLength": 1, "maxLength": 2048},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "nextStep": {"type": "string", "maxLength": 500},
    "blocker": {"type": "string", "maxLength": 1000},
    "completesGoal": {"type": "boolean"}
  }
}
